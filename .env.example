# las-server (Render) environment. Set these in Render → Environment (mark keys as secret).
# Without SUPABASE_URL the server runs exactly as today (public site + app token only).

# --- existing
LAS_API_TOKEN=                # token baked into the Android/Windows apps (comma-separated to rotate)
LAS_MAX_DURATION_SEC=1200     # global video cap (anonymous / apps)
LAS_MAX_FILESIZE=300M
LAS_RATE_PER_HOUR=30          # media requests per IP per hour
LAS_MAX_MEDIA_DOWNLOADS=2     # concurrent yt-dlp jobs (Render free: keep 1-2)
LAS_PROXY=                    # optional http://user:pass@host:port
SERVER_COOKIES=               # optional Netscape cookies.txt contents (secret)

# --- CORS: the Vercel frontend + custom domain (wildcard = one subdomain level)
LAS_CORS_ORIGINS=https://lasconverter.com,https://www.lasconverter.com,https://las-converter-web.vercel.app,https://las-converter-web-*.vercel.app

# --- Supabase (Project Settings → API / Data API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # secret! server only, never in the frontend
SUPABASE_JWT_SECRET=          # only for legacy HS256 projects; new projects use JWKS (leave empty)
LAS_REQUIRE_LOGIN=0           # 1 = website users must log in (apps keep using LAS_API_TOKEN)

# --- Plans (optional overrides; prices in kobo: ₦1,500 = 150000)
LAS_PRICE_MONTHLY_KOBO=150000
LAS_PRICE_YEARLY_KOBO=1200000
LAS_CURRENCY=NGN
# LAS_PLANS_JSON={"free":{"dailyDownloads":10,"maxHeight":720},"premium":{"dailyDownloads":200,"maxHeight":2160}}
LAS_FREE_QUEUE_MAX=3          # free jobs allowed to wait when busy (premium always queues, first)

# --- Paystack (Dashboard → Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY=          # sk_test_... / sk_live_... (secret). Also verifies webhooks.
LAS_PAY_CALLBACK_URL=https://lasconverter.com/account.html?paid=1
# Webhook URL to enter in Paystack: https://las-server.onrender.com/api/pay/webhook

# --- Cloudflare R2 (R2 → Manage API tokens: Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=las-converter-files
LAS_CLOUD_TTL_SEC=86400       # signed link lifetime (add an R2 lifecycle rule: delete after 1 day)

# PAYSTACK_ENABLED=0   # Paystack buttons are only offered in the UI when =1 (routes/webhook stay active)
# --- Bachs (second payment option; OFF until BACHS_ENABLED=1) ---
# BACHS_ENABLED=0
# BACHS_API_KEY=sk_sandbox_...        # sk_live_... for real money; base URL follows the prefix
# BACHS_ENV=sandbox                   # optional override: sandbox | live
# BACHS_WEBHOOK_SECRET=whsec_...      # signing secret of the Bachs webhook endpoint
# LAS_BACHS_SUCCESS_URL=https://lasconverter.lasgconcept.com/account
# LAS_BACHS_CANCEL_URL=https://lasconverter.lasgconcept.com/account
